        <mxCell id="d2_act_admin" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=default;fontSize=10;" value="Bank&#xa;Administrator" vertex="1">
