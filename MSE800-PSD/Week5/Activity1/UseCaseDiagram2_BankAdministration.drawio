<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="bank-admin" name="Bank administration">
    <mxGraphModel dx="1285" dy="777" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d2_purpose" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF4CC;strokeColor=#C9A227;fontSize=11;spacing=10;spacingLeft=12;spacingTop=10;spacingRight=10;spacingBottom=10;fontColor=#333333;" value="&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;This diagram models &lt;b&gt;back-office and maintenance&lt;/b&gt; capabilities that keep the data model consistent: the &lt;i&gt;CURRENCY&lt;/i&gt; catalog and &lt;i&gt;EXCHANGE_RATE&lt;/i&gt; rows, &lt;i&gt;ACCOUNT&lt;/i&gt; lifecycle and &lt;i&gt;ACC_CUST&lt;/i&gt; links, and oversight of &lt;i&gt;TRANSACTION_LOG&lt;/i&gt; for compliance and support." vertex="1">
          <mxGeometry height="92" width="1120" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="d2_actors_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F4FC;strokeColor=#6B9BD1;fontSize=11;spacing=10;spacingLeft=12;spacingTop=10;spacingRight=10;spacingBottom=10;fontColor=#333333;" value="&lt;b&gt;Key actors&lt;/b&gt;&lt;br&gt;&lt;b&gt;Bank Administrator&lt;/b&gt; — staff who configure products, rates, and accounts.&lt;br&gt;&lt;b&gt;Compliance Officer&lt;/b&gt; — may review transaction patterns (read-only oversight).&lt;br&gt;&lt;b&gt;Scheduled Job&lt;/b&gt; (&amp;laquo;System&amp;raquo;) — automated actor that can refresh rate snapshots or roll effective-dated rates into the catalog." vertex="1">
          <mxGeometry height="92" width="1120" x="20" y="122" as="geometry" />
        </mxCell>
        <mxCell id="d2_scenario" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EAF9EE;strokeColor=#62A86F;fontSize=10;spacing=8;spacingLeft=10;spacingTop=8;spacingRight=8;spacingBottom=8;fontColor=#2D4730;" value="&lt;b&gt;Short scenario&lt;/b&gt;&lt;br&gt;1) Admin updates currency catalog and publishes new exchange rates.&lt;br&gt;2) Scheduled job stages rate data for processing.&lt;br&gt;3) Admin searches logs and finds a wrong transaction.&lt;br&gt;4) Admin submits correction with reason and evidence.&lt;br&gt;5) Compliance approves high-value correction before final update." vertex="1">
          <mxGeometry height="250" width="260" x="20" y="228" as="geometry" />
        </mxCell>
        <mxCell id="d2_boundary" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=8;fillColor=#F5F0FF;strokeColor=#7B5BB5;strokeWidth=2;dashed=1;dashPattern=10 10;fontStyle=1;fontSize=12;" value="Money Exchange System&#xa;(Operations boundary)" vertex="1">
          <mxGeometry height="500" width="820" x="300" y="226" as="geometry" />
        </mxCell>
        <mxCell id="d2_uc_curr" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Maintain currency&#xa;catalog (CURRENCY)" vertex="1">
          <mxGeometry height="64" width="180" x="360" y="273" as="geometry" />
        </mxCell>
        <mxCell id="d2_uc_rate" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Publish / update&#xa;exchange rates" vertex="1">
          <mxGeometry height="64" width="170" x="620" y="273" as="geometry" />
        </mxCell>
        <mxCell id="d2_uc_acc" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Create or close&#xa;bank account" vertex="1">
          <mxGeometry height="60" width="160" x="360" y="363" as="geometry" />
        </mxCell>
        <mxCell id="d2_uc_link" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Link / unlink customer&#xa;to account (ACC_CUST)" vertex="1">
          <mxGeometry height="68" width="210" x="600" y="353" as="geometry" />
        </mxCell>
        <mxCell id="d2_uc_log" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Search and export&#xa;transaction log" vertex="1">
          <mxGeometry height="64" width="180" x="360" y="436" as="geometry" />
        </mxCell>
        <mxCell id="d2_uc_fix" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Correct erroneous&#xa;transaction record" vertex="1">
          <mxGeometry height="64" width="180" x="620" y="463" as="geometry" />
        </mxCell>
        <mxCell id="d2_uc_reason" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Validate correction&#xa;reason and evidence" vertex="1">
          <mxGeometry height="68" width="200" x="860" y="453" as="geometry" />
