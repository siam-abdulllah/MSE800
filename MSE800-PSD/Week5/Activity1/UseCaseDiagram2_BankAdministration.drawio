        <mxCell id="d2_uc_approve" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Approve high-value&#xa;correction request" vertex="1">
          <mxGeometry height="68" width="200" x="860" y="553" as="geometry" />
