<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="cust-money" name="Customer money services">
    <mxGraphModel dx="1205" dy="729" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d1_purpose" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF4CC;strokeColor=#C9A227;fontSize=11;spacing=10;spacingLeft=12;spacingTop=10;spacingRight=10;spacingBottom=10;fontColor=#333333;" value="&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;This diagram models what &lt;b&gt;end customers&lt;/b&gt; do in the Money Exchange application: their relationship to accounts (&lt;i&gt;ACC_CUST&lt;/i&gt;), viewing balances, executing transactions in a chosen currency, and reviewing history aligned with &lt;i&gt;TRANSACTION_LOG&lt;/i&gt; and &lt;i&gt;CURRENCY&lt;/i&gt;." vertex="1">
          <mxGeometry height="88" width="1120" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="d1_actors_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F4FC;strokeColor=#6B9BD1;fontSize=11;spacing=10;spacingLeft=12;spacingTop=10;spacingRight=10;spacingBottom=10;fontColor=#333333;" value="&lt;b&gt;Key actors&lt;/b&gt;&lt;br&gt;&lt;b&gt;Customer&lt;/b&gt; — primary human user of self-service banking and exchange.&lt;br&gt;&lt;b&gt;External Rate Provider&lt;/b&gt; (&amp;laquo;System&amp;raquo;) — external system supplying reference rates the app may display before a customer confirms an exchange." vertex="1">
          <mxGeometry height="78" width="1120" x="20" y="118" as="geometry" />
        </mxCell>
        <mxCell id="d1_scenario" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EAF9EE;strokeColor=#62A86F;fontSize=10;spacing=8;spacingLeft=10;spacingTop=8;spacingRight=8;spacingBottom=8;fontColor=#2D4730;" value="&lt;b&gt;Short scenario&lt;/b&gt;&lt;br&gt;1) Customer authenticates.&lt;br&gt;2) Customer requests an exchange quote.&lt;br&gt;3) System validates source balance and executes the exchange.&lt;br&gt;4) System records the transaction and sends confirmation.&lt;br&gt;5) Customer later checks transaction history." vertex="1">
          <mxGeometry height="220" width="260" x="20" y="224" as="geometry" />
        </mxCell>
        <mxCell id="d1_boundary" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=8;fillColor=#F0F7FF;strokeColor=#4A7EB5;strokeWidth=2;dashed=1;dashPattern=10 10;fontStyle=1;fontSize=12;" value="Money Exchange System&#xa;(Customer boundary)" vertex="1">
          <mxGeometry height="520" width="820" x="300" y="210" as="geometry" />
        </mxCell>
        <mxCell id="d1_uc_auth" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Authenticate" vertex="1">
          <mxGeometry height="60" width="150" x="360" y="260" as="geometry" />
        </mxCell>
        <mxCell id="d1_uc_bal" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="View linked accounts&#xa;and balances" vertex="1">
          <mxGeometry height="64" width="170" x="360" y="340" as="geometry" />
        </mxCell>
        <mxCell id="d1_uc_quote" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Get exchange quote&#xa;(source/target currency)" vertex="1">
          <mxGeometry height="68" width="180" x="620" y="270" as="geometry" />
        </mxCell>
        <mxCell id="d1_uc_ex" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="Execute currency exchange&#xa;(record transaction)" vertex="1">
          <mxGeometry height="68" width="200" x="620" y="370" as="geometry" />
        </mxCell>
        <mxCell id="d1_uc_hist" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" value="View transaction history" vertex="1">
          <mxGeometry height="60" width="170" x="360" y="460" as="geometry" />
