        <mxCell id="patient" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;Patient&lt;/b&gt;&lt;hr&gt;- patientId&lt;br&gt;- name&lt;br&gt;- contactNumber&lt;hr&gt;+ requestAppointment()&lt;br&gt;+ payFee()&lt;br&gt;+ orderMedication()" vertex="1">
