          <mxGeometry x="360" y="460" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d1_uc_prof" value="Update contact profile" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="540" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d1_act_cust" value="Customer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=default;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="100" y="360" width="40" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d1_act_rates" value="External&#xa;Rate Provider&#xa;«System»" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=default;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="560" width="50" height="90" as="geometry"/>
