<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="24.7.17" type="device">
  <diagram id="cust-money" name="Customer money services">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d1_purpose" value="&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;This diagram models what &lt;b&gt;end customers&lt;/b&gt; do in the Money Exchange application: their relationship to accounts (&lt;i&gt;ACC_CUST&lt;/i&gt;), viewing balances, executing transactions in a chosen currency, and reviewing history aligned with &lt;i&gt;TRANSACTION_LOG&lt;/i&gt; and &lt;i&gt;CURRENCY&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF4CC;strokeColor=#C9A227;fontSize=11;spacing=10;spacingLeft=12;spacingTop=10;spacingRight=10;spacingBottom=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1120" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="d1_actors_note" value="&lt;b&gt;Key actors&lt;/b&gt;&lt;br&gt;&lt;b&gt;Customer&lt;/b&gt; — primary human user of self-service banking and exchange.&lt;br&gt;&lt;b&gt;External Rate Provider&lt;/b&gt; (&amp;laquo;System&amp;raquo;) — external system supplying reference rates the app may display before a customer confirms an exchange." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F4FC;strokeColor=#6B9BD1;fontSize=11;spacing=10;spacingLeft=12;spacingTop=10;spacingRight=10;spacingBottom=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="118" width="1120" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="d1_boundary" value="Money Exchange System&#xa;(Customer boundary)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=8;fillColor=#F0F7FF;strokeColor=#4A7EB5;strokeWidth=2;dashed=1;dashPattern=10 10;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="210" width="820" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="d1_uc_auth" value="Authenticate" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="260" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d1_uc_bal" value="View linked accounts&#xa;and balances" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="340" width="170" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="d1_uc_quote" value="Get exchange quote&#xa;(source/target currency)" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="270" width="180" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="d1_uc_ex" value="Execute currency exchange&#xa;(record transaction)" style="ellipse;whiteSpace=wrap;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="370" width="200" height="68" as="geometry"/>
        </mxCell>
